# Copy to apps/web/.env.local and fill in. Never commit the real file.

# Neon (free). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# 32 random bytes, base64. Make one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this safe. If you lose it, saved contacts cannot be read.
MASTER_KEY=
# Another 32 random bytes, for searching and hashing. Different from MASTER_KEY.
INDEX_KEY=

# Email (Brevo free). Leave BREVO_API_KEY empty to only print emails in the server log.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Phone Book

# Public web address, no trailing slash.
APP_URL=http://localhost:3000
