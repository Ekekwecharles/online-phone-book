{
  "expo": {
    "name": "Phone Book",
    "slug": "phone-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.online.phonebook"
    },
    "android": {
      "package": "com.online.phonebook",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Phone Book reads your contacts to keep a safe copy online."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://online-phone-book-moaa.vercel.app",
      "eas": {
        "projectId": "e40fecdc-fd8f-4953-84fc-95fa174b7ed8"
      }
    },
    "owner": "snowaregadgets"
  }
}
